 "title": "Por qué pica el ají",
 "pause": 0.18,
 "tail": 0.8,
 "scenes": [
  {
   "key": "picante",
   "text": "El ají picante no está caliente."
  },
  {
   "key": "engania",
   "text": "Engaña a tu cerebro."
  },
  {
   "key": "sensores",
   "text": "Tiene una sustancia que se pega a los mismos sensores de tu lengua que detectan el calor."
  },
  {
   "key": "quemando",
   "text": "Tu cerebro recibe la señal y cree que te estás quemando."
  },
  {
   "key": "sudas",
   "text": "Por eso sudás y te ponés rojo."
  },
  {
   "key": "pajaros",
   "text": "Pero lo más curioso: los pájaros no sienten nada. Se comen los ajíes sin problema y reparten las semillas lejos."
  },
  {
   "key": "planta",
   "text": "La planta inventó el picante para alejar a los mamíferos y dejar comer solo a los pájaros."
  }
