{
 "id": "083",
 "title": "La Estatua de la Libertad era marrón",
 "pause": 0.18,
 "tail": 0.8,
 "scenes": [
  {
   "key": "verde",
   "text": "La Estatua de la Libertad no siempre fue verde."
  },
  {
   "key": "cobre",
   "text": "Cuando la armaron en 1886, era del color de una moneda nueva de cobre: marrón y brillante."
  },
  {
   "key": "capa",
   "text": "Está hecha de una capa de cobre muy finita."
  },
  {
   "key": "oxidando",
   "text": "Con los años, la lluvia, el aire y la sal del mar la fueron oxidando, y se formó una capa verde por encima."
  },
  {
   "key": "protege",
   "text": "Esa capa no la arruina. Al contrario: la protege."
  },
  {
   "key": "pintarla",
   "text": "Por eso decidieron no pintarla nunca."
  }
 ],
