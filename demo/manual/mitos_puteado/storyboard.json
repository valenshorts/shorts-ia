 "scenes": [
  {
   "key": "hook",
   "text": "Atención, gil: hay cosas que te creíste toda la vida y son mentira. Vamos una por una."
  },
  {
   "key": "cerebro",
   "text": "No usás solo el diez por ciento del cerebro. Usás todo, aunque no parezca, salame."
  },
  {
   "key": "chicle",
   "text": "Si te tragás un chicle, no se queda siete años en la panza. Sale en unos días, como todo, boludo."
  },
  {
   "key": "murcielago",
   "text": "Los murciélagos no son ciegos. Ven, y encima usan el eco para ubicarse. Ven mejor que vos sin anteojos, nabo."
  },
  {
   "key": "rayo",
   "text": "Y el rayo sí cae dos veces en el mismo lugar. Al Empire State le caen unos veinte por año, tarado."
  },
  {
   "key": "cierre",
   "text": "Así que dejá de repetir giladas en la mesa, pelotudo. Mandáselo al que se las sabe todas."
  }
 ],
