{
 "id": "113",
 "title": "La cucaracha sin cabeza (versión puteada)",
 "nota": "Formato puteador. Subtítulos censurados con asterisco (caption_replace).",
 "pause": 0.15,
 "tail": 0.8,
 "scenes": [
  {
   "key": "hook",
   "text": "La cucaracha es la hija de puta más indestructible del planeta, boludo."
  },
  {
   "key": "cabeza",
   "text": "Le cortás la cabeza y la muy turra sigue viva una semana entera."
  },
  {
   "key": "sed",
   "text": "¿Y sabés de qué se muere? De sed, la pelotuda. Porque sin cabeza no tiene boca para tomar agua."
  },
  {
   "key": "respira",
   "text": "Respira por unos agujeritos que tiene en el cuerpo, así que la cabeza le chupa un huevo."
  },
  {
   "key": "aire",
   "text": "Y puede aguantar la respiración cuarenta minutos, la concha de su madre."
  },
  {
   "key": "dinos",
   "text": "Está en la Tierra hace trescientos millones de años. Vio pasar a los dinosaurios, boludo."
  },
  {
   "key": "cierre",
   "text": "Los dinosaurios se murieron todos. Y esta forra sigue acá, en tu cocina."
  }
 ],
