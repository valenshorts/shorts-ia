{
 "id": "114",
 "title": "El perezoso (versión puteada)",
 "nota": "Formato puteador. Subtítulos censurados con asterisco (caption_replace).",
 "pause": 0.15,
 "tail": 0.8,
 "scenes": [
  {
   "key": "hook",
   "text": "El perezoso es el hijo de puta más vago de toda la selva, boludo."
  },
  {
   "key": "algas",
   "text": "Es tan lento que le crecen algas en el pelo. Literalmente se pone verde, el pelotudo."
  },
  {
   "key": "digiere",
   "text": "Tarda casi un mes en digerir una hoja. ¡Un mes, la concha de su madre!"
  },
  {
   "key": "baja",
   "text": "Y baja del árbol una sola vez por semana. ¿Para qué? Para cagar."
  },
  {
   "key": "peso",
   "text": "En una sola cagada puede perder un tercio de su peso, el muy hijo de puta."
  },
  {
   "key": "nada",
   "text": "Y encima nada mejor de lo que camina: aguanta la respiración cuarenta minutos bajo el agua."
  },
  {
   "key": "cierre",
   "text": "Así que la próxima vez que te digan vago, deciles que sos un perezoso, forro."
  }
 ],
