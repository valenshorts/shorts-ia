 "scenes": [
  {
   "key": "hook",
   "text": "Escuchame, salame: en Venus un día dura más que un año. Sí, leíste bien, gil."
  },
  {
   "key": "dia",
   "text": "Venus tarda doscientos cuarenta y tres días en dar una vuelta sobre sí mismo. Más lento que vos un lunes, nabo."
  },
  {
   "key": "anio",
   "text": "Pero da la vuelta al Sol en doscientos veinticinco. O sea, el año se termina antes que el día, pelotudo."
  },
  {
   "key": "reves",
   "text": "Y encima gira al revés: allá el Sol sale por el oeste. Planeta contrera, como tu tío en Navidad."
  },
  {
   "key": "calor",
   "text": "Hace unos cuatrocientos sesenta y cinco grados. Más caliente que Mercurio, que está más cerca del Sol. Un horno, boludo."
  },
  {
   "key": "cierre",
   "text": "Así que si te quejás de que el día no te alcanza, mudate a Venus, tarado. Ah, no, te cocinás."
  }
 ],
