 "scenes": [
  {
   "key": "dinosaurios",
   "text": "En la época de los dinosaurios, el día duraba menos de veinticuatro horas."
  },
  {
   "key": "hace",
   "text": "Hace setenta millones de años, un día duraba más o menos veintitrés horas y media."
  },
  {
   "key": "luna",
   "text": "La razón es la Luna."
  },
  {
   "key": "freno",
   "text": "Su fuerza tira del mar y frena a la Tierra muy despacito, como un freno de mano."
  },
  {
   "key": "siglo",
   "text": "Cada siglo, el día se alarga un poquito."
  },
  {
   "key": "futuro",
   "text": "Y no se detiene: dentro de millones de años, el día va a durar más de veinticinco horas."
  }
 ],
