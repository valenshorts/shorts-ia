 "sources": [
  "Torre Eiffel: 330 m de altura con antenas (sitio oficial toureiffel.paris)",
  "Dilatación térmica: hasta unos 15 cm más alta en verano",
  "El lado al sol se dilata más, la punta se aleja del sol"
 ],
 "scenes": [
  {
   "key": "gancho",
   "text": "La Torre Eiffel no mide lo mismo en verano que en invierno."
  },
  {
   "key": "dato",
   "text": "Con el calor, puede crecer hasta quince centímetros."
  },
  {
   "key": "hierro",
   "text": "Es que está hecha de hierro, y el hierro se estira cuando se calienta."
  },
  {
   "key": "suma",
   "text": "Cada viga se alarga un poquito, pero en trescientos treinta metros de torre, esos poquitos se suman."
  },
  {
   "key": "sol",
   "text": "Y como el lado del sol se calienta más que el de la sombra, la punta se inclina hacia el otro lado."
  },
  {
   "key": "cierre",
   "text": "En invierno, con el frío, vuelve a encogerse, hasta el próximo verano."
  }
 ],
