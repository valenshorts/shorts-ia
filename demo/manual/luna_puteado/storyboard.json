 "scenes": [
  {
   "key": "hook",
   "text": "Escuchame, nabo: la Luna se está yendo. Se aleja de la Tierra todos los años, la muy ortiva."
  },
  {
   "key": "cm",
   "text": "Se aleja unos cuatro centímetros por año. Más o menos lo que te crecen las uñas, boludo."
  },
  {
   "key": "laser",
   "text": "Lo sabemos porque los astronautas dejaron espejos allá arriba, y les tiramos un láser. Ciencia de verdad, gil."
  },
  {
   "key": "dias",
   "text": "Y como se aleja, los días se alargan de a poquito. Cuando había dinosaurios, el día duraba menos, salame."
  },
  {
   "key": "cara",
   "text": "Y siempre te muestra la misma cara: el lado de atrás no lo ves nunca. Tímida, como vos en un boliche, tarado."
  },
  {
   "key": "cierre",
   "text": "Tranqui, que para que se note falta muchísimo. Igual que para que ordenes tu pieza, pelotudo."
  }
 ],
