 "scenes": [
  {"key": "peso", "text": "Una nube esponjosa normal pesa unas quinientas toneladas."},
  {"key": "elefantes", "text": "Lo mismo que unos cien elefantes."},
  {"key": "gotitas", "text": "Parece imposible que algo tan pesado flote, pero ese peso está repartido en millones de gotitas diminutas, separadas en un espacio enorme."},
  {"key": "aire", "text": "Cada gotita es tan liviana que el aire caliente que sube la mantiene arriba."},
  {"key": "caen", "text": "Cuando las gotitas se juntan y se hacen más grandes, ya no se pueden sostener, y caen."},
  {"key": "lluvia", "text": "Eso es la lluvia."}
