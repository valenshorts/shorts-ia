{
 "id": "109",
 "title": "El matcha se cultiva a la sombra",
 "pause": 0.18,
 "tail": 0.8,
 "scenes": [
  {
   "key": "matcha",
   "text": "El matcha es tan verde porque las plantas pasan sus últimas semanas a la sombra."
  },
  {
   "key": "sombra",
   "text": "Unas tres semanas antes de la cosecha, cubren las plantas de té con redes o paja."
  },
  {
   "key": "clorofila",
   "text": "Con poca luz, las hojas fabrican más clorofila para aprovechar el sol que les llega, y se ponen de un verde intenso."
  },
  {
   "key": "molinos",
   "text": "Después las secan, les quitan las venas y las muelen en molinos de piedra hasta hacerlas polvo."
  },
  {
   "key": "hoja",
   "text": "Por eso con el matcha te tomás la hoja entera."
  }
 ],
